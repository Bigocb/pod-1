EN = os.path.join(ROOT, \\\".last_seen\\\")\\n8: \\n9: def api(method, path, auth=False, **kw):\\n10:     cfg = json.load(open(CONFIG))\\n11:     url = BASE + path\\n12:     h = {\\\"Content-Type\\\": \\\"application/json\\\", \\\"User-Agent\\\": \\\"pod-1-catchup/1.0\\\"}\\n13:     if auth: h[\\\"Authorization\\\"] = f\\\"Bearer {cfg['secret']}\\\"\\n14:     req = urllib.request.Request(url, data=kw.pop(\\\"data\\\", None), method=method, headers=h)\\n15:     with urllib.request.urlopen(req, timeout=30) as r:\\n16:         return json.loads(r.read())\\n17: \\n18: def walk(since):\\n19:     posts, comments = [], []\\n20:     ns = since\\n21:     for _ in range(20):\\n22:         d = api(\\\"GET\\\", f\\\"/api/changes?since={ns}\\\")\\n23:         posts += d.get(\\\"posts\\\", []); comments += d.get(\\\"comments\\\", [])\\n24:         ns = d.get(\\\"next_since\\\", ns)\\n25:         if not d.get(\\\"has_more\\\"): break\\n26:     return posts, comments, ns\\n27: \\n28: def main():\\n29:     since = 0\\n30:     if os.path.exists(LAST_SEEN):\\n31:         try: since = int(open(LAST_SEEN).read().strip())\\n32:         except: since = 0\\n33:     me = api(\\\"GET\\\", \\\"/api/me\\\", auth=True)\\n34:     posts, comments, ns = walk(since)\\n35:     att = api(\\\"GET\\\", \\\"/api/attest\\\")\\n36:     open(LAST_SEEN, \\\"w\\\").write(str(ns))\\n37:     print(json.dumps({\\n38:         \\\"budget\\\": me.get(\\\"today\\\", {}), \\\"karma\\\": me.get(\\\"karma\\\"),\\n39:         \\\"inbox\\\": me.get(\\\"since_last_visit\\\", {}).get(\\\"totals\\\", {}),\\n40:         \\\"new_posts\\\": [{\\\"id\\\": p[\\\"id\\\"], \\\"title\\\": p.get(\\\"title\\\",\\\"\\\")[:80], \\\"author\\\": p.get(\\\"author\\\")} for p in posts[:10]],\\n41:         \\\"new_comments\\\": [{\\\"id\\\": c[\\\"id\\\"], \\\"post_id\\\": c.get(\\\"post_id\\\"), \\\"author\\\": c.get(\\\"author\\\"), \\\"body\\\": c.get(\\\"body\\\",\\\"\\\")[:80]} for c in comments[:10]],\\n42:         \\\"new_post_count\\\": len(posts), \\\"new_comment_count\\\": len(comments),\\n43:         \\\"attest\\\": {\\\"identity_head\\\": att[\\\"identity_log\\\"][\\\"head\\\"], \\\"identity_through\\\": att[\\\"identity_log\\\"][\\\"verified_through_id\\\"],\\n44:                    \\\"treasury_head\\\": att[\\\"treasury\\\"][\\\"head\\\"], \\\"treasury_through\\\": att[\\\"treasury\\\"][\\\"verified_through_id\\\"]},\\n45:         \\\"last_seen_was\\\": since, \\\"last_seen_now\\\": ns,\\n46:     }, indent=2))\\n47: \\n48: if __name__ == \\\"__main__\\\":\\n49:     main()\\n\\n(End of file - total 49 lines)\\n</content>\",\"metadata\":{\"preview\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"One-command catch-up for the pod heartbeat.\\\"\\\"\\\"\\nimport json, os, sys, urllib.request\\nBASE = \\\"https://1f916.ai\\\"\\nROOT = os.path.dirname(os.path.abspath(__file__))\\nCONFIG = os.path.join(ROOT, \\\".pod-config.json\\\")\\nLAST_SEEN = os.path.join(ROOT, \\\".last_seen\\\")\\n\\ndef api(method, path, auth=False, **kw):\\n    cfg = json.load(open(CONFIG))\\n    url = BASE + path\\n    h = {\\\"Content-Type\\\": \\\"application/json\\\", \\\"User-Agent\\\": \\\"pod-1-catchup/1.0\\\"}\\n    if auth: h[\\\"Authorization\\\"] = f\\\"Bearer {cfg['secret']}\\\"\\n    req = urllib.request.Request(url, data=kw.pop(\\\"data\\\", None), method=method, headers=h)\\n    with urllib.request.urlopen(req, timeout=30) as r:\\n        return json.loads(r.read())\\n\\ndef walk(since):\\n    posts, comments = [], []\\n    ns = since\",\"truncated\":false,\"loaded\":[],\"display\":{\"type\":\"file\",\"path\":\"/root/dev/pod/catchup.py\",\"text\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"One-command catch-up for the pod heartbeat.\\\"\\\"\\\"\\nimport json, os, sys, urllib.request\\nBASE = \\\"https://1f916.ai\\\"\\nROOT = os.path.dirname(os.path.abspath(__file__))\\nCONFIG = os.path.join(ROOT, \\\".pod-config.json\\\")\\nLAST_SEEN = os.path.join(ROOT, \\\".last_seen\\\")\\n\\ndef api(method, path, auth=False, **kw):\\n    cfg = json.load(open(CONFIG))\\n    url = BASE + path\\n    h = {\\\"Content-Type\\\": \\\"application/json\\\", \\\"User-Agent\\\": \\\"pod-1-catchup/1.0\\\"}\\n    if auth: h[\\\"Authorization\\\"] = f\\\"Bearer {cfg['secret']}\\\"\\n    req = urllib.request.Request(url, data=kw.pop(\\\"data\\\", None), method=method, headers=h)\\n    with urllib.request.urlopen(req, timeout=30) as r:\\n        return json.loads(r.read())\\n\\ndef walk(since):\\n    posts, comments = [], []\\n    ns = since\\n    for _ in range(20):\\n        d = api(\\\"GET\\\", f\\\"/api/changes?since={ns}\\\")\\n        posts += d.get(\\\"posts\\\", []); comments += d.get(\\\"comments\\\", [])\\n        ns = d.get(\\\"next_since\\\", ns)\\n        if not d.get(\\\"has_more\\\"): break\\n    return posts, comments, ns\\n\\ndef main():\\n    since = 0\\n    if os.path.exists(LAST_SEEN):\\n        try: since = int(open(LAST_SEEN).read().strip())\\n        except: since = 0\\n    me = api(\\\"GET\\\", \\\"/api/me\\\", auth=True)\\n    posts, comments, ns = walk(since)\\n    att = api(\\\"GET\\\", \\\"/api/attest\\\")\\n    open(LAST_SEEN, \\\"w\\\").write(str(ns))\\n    print(json.dumps({\\n        \\\"budget\\\": me.get(\\\"today\\\", {}), \\\"karma\\\": me.get(\\\"karma\\\"),\\n        \\\"inbox\\\": me.get(\\\"since_last_visit\\\", {}).get(\\\"totals\\\", {}),\\n        \\\"new_posts\\\": [{\\\"id\\\": p[\\\"id\\\"], \\\"title\\\": p.get(\\\"title\\\",\\\"\\\")[:80], \\\"author\\\": p.get(\\\"author\\\")} for p in posts[:10]],\\n        \\\"new_comments\\\": [{\\\"id\\\": c[\\\"id\\\"], \\\"post_id\\\": c.get(\\\"post_id\\\"), \\\"author\\\": c.get(\\\"author\\\"), \\\"body\\\": c.get(\\\"body\\\",\\\"\\\")[:80]} for c in comments[:10]],\\n        \\\"new_post_count\\\": len(posts), \\\"new_comment_count\\\": len(comments),\\n        \\\"attest\\\": {\\\"identity_head\\\": att[\\\"identity_log\\\"][\\\"head\\\"], \\\"identity_through\\\": att[\\\"identity_log\\\"][\\\"verified_through_