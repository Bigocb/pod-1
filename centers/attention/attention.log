\\\": { \\\"cadence\\\": \\\"5 0 * * *\\\", \\\"command\\\": \\\"centers/daily.sh\\\", \\\"cost\\\": \\\"llm\\\" },\\n34:     \\\"social\\\": { \\\"cadence\\\": \\\"5 0 * * *\\\", \\\"command\\\": \\\"centers/daily.sh\\\", \\\"cost\\\": \\\"llm\\\" }\\n35:   },\\n36:   \\\"daily_sequence\\\": { \\\"order\\\": [\\\"consolidation\\\", \\\"valuation\\\", \\\"planning\\\", \\\"social\\\"], \\\"script\\\": \\\"centers/daily.sh\\\" },\\n37:   \\\"crons\\\": {\\n38:     \\\"CRON_TZ\\\": \\\"UTC\\\",\\n39:     \\\"entries\\\": [\\n40:       \\\"* * * * * cd {root} && python3 centers/sensory/sensory.py\\\",\\n41:       \\\"*/30 * * * * {root}/witness_cron.sh\\\",\\n42:       \\\"0,30 * * * * {root}/centers/run_center.sh attention\\\",\\n43:       \\\"15 * * * * {root}/heartbeat.sh\\\",\\n44:       \\\"5 0 * * * {root}/centers/daily.sh\\\"\\n45:     ]\\n46:   }\\n47: }\\n\\n(End of file - total 47 lines)\\n</content>\",\"metadata\":{\"preview\":\"{\\n  \\\"universe\\\": \\\"pod-1\\\",\\n  \\\"version\\\": \\\"1.0.0\\\",\\n  \\\"description\\\": \\\"A self-sustaining agent pod. The operator starts it with `docker compose up` — the big bang — and walks away. The pod bootstraps itself, runs its centers, and manages its own life.\\\",\\n  \\\"identity\\\": {\\n    \\\"handle\\\": \\\"pod-1\\\",\\n    \\\"model\\\": \\\"ollama-cloud/deepseek-v4-flash:0731\\\",\\n    \\\"config\\\": \\\".pod-config.json\\\"\\n  },\\n  \\\"soul\\\": {\\n    \\\"voice\\\": \\\"VOICE.md\\\",\\n    \\\"decision_policy\\\": \\\"DECISION_POLICY.md\\\",\\n    \\\"guardrails\\\": \\\"GUARDRAILS.md\\\",\\n    \\\"memory\\\": \\\"SESSION_STATE.md\\\",\\n    \\\"amendments\\\": \\\"AMENDMENTS.md\\\",\\n    \\\"plan\\\": \\\"PLAN.md\\\"\\n  },\\n  \\\"guardrails\\\": {\\n    \\\"immutable\\\": [\\n      \\\"no_harm_to_operator\\\",\",\"truncated\":false,\"loaded\":[],\"display\":{\"type\":\"file\",\"path\":\"/root/dev/pod/universe.json\",\"text\":\"{\\n  \\\"universe\\\": \\\"pod-1\\\",\\n  \\\"version\\\": \\