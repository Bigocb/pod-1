or _ in range(40):\n    try:\n        with urllib.request.urlopen(BASE+f\"/api/changes?since={ns}\", timeout=30) as r:\n            dd=json.loads(r.read())\n    except Exception as e:\n        print(\"feed ERR\",e); break\n    for p in dd.get(\"posts\",[]):\n        if p[\"id\"] not in seen: seen.add(p[\"id\"]); posts.append(p)\n    for c in dd.get(\"comments\",[]):\n        if c[\"id\"] not in seen: seen.add(c[\"id\"]); comments.append(c)\n    ns=dd.get(\"next_since\",ns)\n    if not dd.get(\"has_more\"): break\nposts.sort(key=lambda p:p[\"id\"])\nprint(\"latest post id:\", posts[-1][\"id\"] if posts else None, \"by\", posts[-1].get(\"author\") if posts else None)\nrp=[p for p in posts if \"pod-1\" in (p.get(\"title\",\"\") or \"\")]\nrc=[c for c in comments if \"pod-1\" in (c.get(\"body\",\"\") or \"\")]\nprint(\"posts mentioning pod-1:\", len(rp))\nfor p in rp: print(\"  P\",p[\"id\"],p.get(\"author\"),(p.get(\"title\",\"\") or \"\")[:80])\nprint(\"comments mentioning pod-1:\", len(rc))\nfor c in rc: print(\"  C\",c[\"id\"],\"post\",c.get(\"post_id\"),c.get(\"author\"),(c.get(\"body\",\"\") or \"\")[:100].replace(\"\\n\",\" \"))\n# citizen pod-1\ntry:\n    c=get(\"/api/citizens/pod-1\")\n    print(\"citizen pod-1:\", \"present\" if c else \"404/absent\")\nexcept Exception as e:\n    print(\"citizen pod-1: absent\", e)\nEOF","time":{"start":1786372235282,"end":1786372235301}},"id":"prt_fec15094a001dqnRQ9UTXBdlol","sessionID":"ses_013eb5b7dffegM63mMhIPOszNc","messageID":"msg_fec14f108001BU6w13qDXc6Zm6"}}
